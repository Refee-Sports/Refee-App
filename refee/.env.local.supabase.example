# Local Supabase stack (`supabase start`) — no Twilio; uses [auth.sms.test_otp] in supabase/config.toml
# Copy to .env.local.supabase (gitignored) and fill the anon key from `supabase status`.
#
# Flow:
#   1. From refee/: supabase start
#   2. supabase status  → copy API URL + Publishable (or anon) key below
#   3. cp .env.local.supabase.example .env.local.supabase
#   4. npm run start:local
#
# Sign-in: use phone (555) 555-0100  →  app sends +15555550100  →  OTP is always 123456 (see config.toml)

EXPO_PUBLIC_APP_ENV=development

# Simulator on this Mac: use 127.0.0.1. Physical device (Expo Go): use your Mac's LAN IP, e.g. http://192.168.1.151:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Use Publishable from `supabase status` — NOT the Secret (sb_secret_…) key
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...paste-from-supabase-status...

# Optional placeholders (OAuth still targets hosted providers unless you configure local)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
EXPO_PUBLIC_PERSONA_TEMPLATE_ID=itmpl_xxx
EXPO_PUBLIC_PERSONA_ENVIRONMENT=sandbox
