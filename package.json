{
  "name": "refee",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web": "npm run dev -w apps/web",
    "web:build": "npm run build -w apps/web",
    "mobile": "npm run start -w apps/mobile",
    "mobile:local": "npm run start:local -w apps/mobile",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public > packages/core/src/database.types.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "supabase": "^2.98.2"
  },
  "engines": {
    "node": ">=22"
  }
}
