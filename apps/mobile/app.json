{
  "expo": {
    "name": "Refee",
    "slug": "refee",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "refee",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fd10513b-047f-4df3-9169-80c377812980",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.refee.app",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "associatedDomains": [
        "applinks:refee.app",
        "webcredentials:refee.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#E5E1D6"
      },
      "package": "com.refee.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "refee.app",
              "pathPrefix": "/join/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E5E1D6",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#08111C"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1F4FCC"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-updates",
      "@sentry/react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "Refee uses your photos so you can choose a headshot for your profile and upload your background check.",
          "cameraPermission": "Refee uses your camera so you can take a headshot for your profile."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Refee uses your location while the app is open to show games near you.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "fd10513b-047f-4df3-9169-80c377812980"
      }
    }
  }
}
