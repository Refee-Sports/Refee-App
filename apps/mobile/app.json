{
  "expo": {
    "name": "Refee",
    "slug": "refee",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "refee",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fd10513b-047f-4df3-9169-80c377812980",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "backgroundColor": "#08111C",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.refee.app",
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08111C"
      },
      "package": "com.refee.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-updates",
      "@sentry/react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "Refee uses your photos so you can choose a headshot for your profile and upload your background check.",
          "cameraPermission": "Refee uses your camera so you can take a headshot for your profile."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Refee uses your location while the app is open to show games near you.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "fd10513b-047f-4df3-9169-80c377812980"
      }
    }
  }
}
