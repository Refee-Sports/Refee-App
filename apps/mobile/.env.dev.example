# Local / daily development — separate Supabase project or supabase start (local stack)
EXPO_PUBLIC_APP_ENV=development

# Supabase (dev project or http://127.0.0.1:54321 when using Supabase CLI locally)
EXPO_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-dev-anon-key

# Stripe — test keys for development
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Persona — sandbox for development
EXPO_PUBLIC_PERSONA_TEMPLATE_ID=itmpl_xxx
EXPO_PUBLIC_PERSONA_ENVIRONMENT=sandbox
