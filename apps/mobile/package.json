{
  "name": "@refee/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "dotenv -e .env.dev -- expo start",
    "start:clear": "dotenv -e .env.dev -- expo start --clear",
    "start:local": "REFEE_ENV_FILE=.env.local.supabase EXPO_NO_DOTENV=1 expo start",
    "start:local:clear": "REFEE_ENV_FILE=.env.local.supabase EXPO_NO_DOTENV=1 expo start --clear",
    "start:stg": "dotenv -e .env.stg -- expo start",
    "start:prod": "dotenv -e .env.prod -- expo start",
    "android": "dotenv -e .env.dev -- expo start --android",
    "android:local": "REFEE_ENV_FILE=.env.local.supabase env EXPO_NO_DOTENV=1 expo start --android",
    "ios": "dotenv -e .env.dev -- expo start --ios",
    "ios:local": "REFEE_ENV_FILE=.env.local.supabase env EXPO_NO_DOTENV=1 expo start --ios",
    "web": "dotenv -e .env.dev -- expo start --web",
    "web:local": "REFEE_ENV_FILE=.env.local.supabase env EXPO_NO_DOTENV=1 expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "quality": "npm run lint && npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@expo-google-fonts/inter-tight": "^0.2.3",
    "@expo-google-fonts/jetbrains-mono": "^0.2.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@refee/core": "*",
    "@stripe/stripe-react-native": "0.50.3",
    "@supabase/supabase-js": "^2.45.0",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^4.1.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.10",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.12",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2",
    "vitest": "^2.1.9"
  },
  "private": true
}
