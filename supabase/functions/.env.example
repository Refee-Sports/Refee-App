# Secrets for Supabase Edge Functions (local: supabase functions serve --env-file supabase/functions/.env)
# Get the secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
# Signing secret from `stripe listen` locally or the production webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Geocoding provider. Leave unset to use Nominatim (OpenStreetMap) — free, no
# key, fine for dev/low volume. For production set GEOCODER=google and provide
# a key (higher rate limits, commercial terms).
# GEOCODER=google
# GOOGLE_MAPS_API_KEY=your-google-maps-geocoding-key

# AI schedule import (extract-schedule). Server-side only — never in the apps.
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5
# AI_EXTRACT_DAILY_LIMIT=30

# Identity verification (Didit). Sandbox and live are separate applications with
# separate keys — use the sandbox one until the flow is proven end to end.
# API key and workflow id: https://business.didit.me → your application.
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
# secret_shared_key from the webhook destination (POST /v3/webhook/destinations/).
DIDIT_WEBHOOK_SECRET=
# Where Didit sends the person when they're done, e.g.
# http://localhost:3000/verify/done or https://refee.app/verify/done
DIDIT_CALLBACK_URL=
